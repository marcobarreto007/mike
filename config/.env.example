# =============================================================================
# MIKE Configuration Priority (highest to lowest)
# =============================================================================
#
# Tier 1  Runtime Overrides  — In-memory via set_runtime_override().
#                                Set by governance/autonomy at runtime without
#                                touching the filesystem.  Survives only for the
#                                lifetime of the process.
#
# Tier 2  .env.runtime        — Machine-specific, auto-generated values.
#                                Written by launch scripts (GPU detection,
#                                profile resolution).  Never committed.
#
# Tier 3  .env                — User secrets and local overrides.
#                                API keys, tokens, per-machine preferences.
#                                Never committed.  Copy from .env.example.
#
# Tier 4  .env.example        — Documented defaults (this file).
#                                Committed to the repo.  Safe to share.
#                                Every variable here has a sensible fallback
#                                coded in mike_config.py.
# =============================================================================

BRAVE_API_KEY=
# Unico cerebro do Mike: Qwen local via llama-server.
# Hardware atual: RTX 5060 Ti 16GB + RTX 3060 12GB + 64GB RAM (docs/HARDWARE.md)
MIKE_LLM_BACKEND=llama_server
MIKE_LLM_BACKENDS=llama_server
MIKE_LLAMA_SERVER_URL=http://127.0.0.1:8081/v1
MIKE_LLAMA_SERVER_MODEL=mike
MIKE_QWEN_ENABLE_THINKING=false
MIKE_MODEL_REPO=unsloth/Qwen3.6-35B-A3B-MTP-GGUF
# Recomendado dual-GPU atual: UD-Q3_K_M | legado validado: UD-IQ4_XS
MIKE_MODEL_FILE=Qwen3.6-35B-A3B-UD-Q3_K_M.gguf
# Qwen3.8-Max (2.4T) = API cloud, nao GGUF desktop. Local futuro: 3.8-27B.
MEM0_API_KEY=
MEM0_ORG_ID=
MEM0_PROJECT_ID=
MIKE_MEM0_MODE=auto
MIKE_MEM0_INFER=false
MIKE_MEM0_COLLECTION=mike_mem0
MIKE_MEM0_EMBED_MODEL=BAAI/bge-small-en-v1.5
MIKE_MEM0_EMBED_DIMS=384
MIKE_MEM0_QDRANT_DIR=qdrant_store
MIKE_MEM0_SCOPE=global
MIKE_MEM0_TELEMETRY=false
MIKE_MEM0_OPENAI_BASE_URL=http://127.0.0.1:8081/v1
MIKE_LIGHTRAG_LLM_BASE_URL=http://127.0.0.1:8081/v1
# Rede: 0.0.0.0 = acessivel na LAN (familia), 127.0.0.1 = so esta maquina
MIKE_HOST=0.0.0.0
MIKE_PORT=8083
MIKE_API_KEY=
MIKE_PROFILE_AUTH_ENABLED=false
MIKE_SESSION_SECRET=
MIKE_SESSION_TTL_HOURS=12
MIKE_SESSION_COOKIE_NAME=mike_session
MIKE_SESSION_COOKIE_SAMESITE=strict
MIKE_SESSION_COOKIE_SECURE=false
MIKE_PROFILE_MARCO_PASSWORD=
MIKE_PROFILE_ANAPAULA_PASSWORD=
MIKE_PROFILE_RAPHAEL_PASSWORD=
MIKE_PROFILE_VISITANTE_PASSWORD=
MIKE_ENABLE_MCP_TOOLS=true
MIKE_MCP_MAX_STEPS=8
MIKE_MCP_TOOL_SERVER=
MIKE_MCP_ALLOWED_ROOTS=
MIKE_MCP_SERVERS_FILE=
MIKE_MCP_SERVERS_JSON=
MIKE_GMAIL_ADDRESS=
MIKE_GMAIL_TOKEN=
MIKE_GOOGLE_TOKEN=
MIKE_CALENDAR_TOKEN=
MIKE_DRIVE_TOKEN=
MIKE_CALENDAR_TIMEZONE=America/Toronto
MIKE_GOOGLE_CREDENTIALS=
MIKE_TRUST_LOCALHOST=true
MIKE_ALLOW_UNAUTH_HEALTHCHECK=true
MIKE_ALLOW_INSECURE_LAN=false
MIKE_CORS_ORIGINS=http://127.0.0.1,http://localhost,http://127.0.0.1:8083,http://localhost:8083
MIKE_ENABLE_RAG=true
MIKE_ENABLE_VISION=false
MIKE_ENABLE_WEB_SEARCH=true
MIKE_WEB_SEARCH_PROVIDER=auto
MIKE_WEB_REQUEST_TIMEOUT_SECONDS=0
MIKE_RUNTIME_PROFILE=auto
MIKE_DEFAULT_MAX_TOKENS=2048
MIKE_STREAM_KEEPALIVE_SECONDS=10
MIKE_GPU_DETECT_TIMEOUT_SECONDS=5
# GPU: 99 = todas as camadas; ajuste conforme VRAM disponivel
MIKE_CTX_SIZE=8192
MIKE_GPU_LAYERS=99
MIKE_N_BATCH=1024
MIKE_N_UBATCH=512
MIKE_FLASH_ATTN=true
MIKE_OFFLOAD_KQV=true
# KV cache: 8=Q8_0 (economico), 1=F16 (qualidade maxima)
MIKE_KV_TYPE_K=8
MIKE_KV_TYPE_V=8
MIKE_MEM0_MIN_TOTAL_CHARS=48

# Comunicacao proativa
MIKE_TELEGRAM_ENABLED=false
MIKE_TELEGRAM_BOT_TOKEN=
MIKE_TELEGRAM_CHAT_MARCO=
MIKE_TELEGRAM_CHAT_FAMILIA=
MIKE_TWILIO_ACCOUNT_SID=
MIKE_TWILIO_AUTH_TOKEN=
MIKE_TWILIO_PHONE_FROM=
MIKE_TWILIO_WEBHOOK_BASE=
MIKE_TWILIO_ENABLED=false
# Local development only. Never enable on a public endpoint.
MIKE_TWILIO_SKIP_VALIDATION=false

# Integracoes opcionais
GITHUB_TOKEN=
HF_TOKEN=
MIKE_GRAPH_ENABLED=false
MIKE_NEO4J_URI=bolt://localhost:7687
MIKE_NEO4J_USER=neo4j
MIKE_NEO4J_PASS=
MIKE_ELEVENLABS_API_KEY=
MIKE_ELEVENLABS_VOICE_ID=

# Remote Exec MCP (mike-agent Node.js em outra maquina)
MIKE_REMOTE_AGENT_URL=http://192.168.40.60:3000
MIKE_REMOTE_AGENT_KEY=
MIKE_REMOTE_AGENT_EXEC_PATH=/api/powershell
MIKE_REMOTE_AGENT_TIMEOUT=20
MIKE_REMOTE_EXEC_TIMEOUT=30
