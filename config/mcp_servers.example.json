[
  {
    "name": "gmail",
    "command": "${MIKE_HOME}\\.venv\\Scripts\\python.exe",
    "args": ["core/mcp/mike_email_mcp.py"],
    "tool_prefix": "gmail",
    "capabilities": ["email", "gmail", "google_workspace"],
    "access": "owner",
    "env": {
      "MIKE_GMAIL_ADDRESS": "${MIKE_GMAIL_ADDRESS}",
      "MIKE_GMAIL_TOKEN": "${MIKE_GMAIL_TOKEN}",
      "MIKE_GOOGLE_TOKEN": "${MIKE_GOOGLE_TOKEN}"
    }
  },
  {
    "name": "calendar",
    "command": "${MIKE_HOME}\\.venv\\Scripts\\python.exe",
    "args": ["core/mcp/mike_calendar_mcp.py"],
    "tool_prefix": "calendar",
    "capabilities": ["calendar"],
    "access": "owner",
    "env": {
      "MIKE_CALENDAR_TOKEN": "${MIKE_CALENDAR_TOKEN}",
      "MIKE_GOOGLE_TOKEN": "${MIKE_GOOGLE_TOKEN}",
      "MIKE_CALENDAR_TIMEZONE": "${MIKE_CALENDAR_TIMEZONE}"
    }
  },
  {
    "name": "drive",
    "command": "${MIKE_HOME}\\.venv\\Scripts\\python.exe",
    "args": ["core/mcp/mike_drive_mcp.py"],
    "tool_prefix": "drive",
    "capabilities": ["drive", "documents", "google_workspace"],
    "access": "owner",
    "env": {
      "MIKE_DRIVE_TOKEN": "${MIKE_DRIVE_TOKEN}",
      "MIKE_GOOGLE_TOKEN": "${MIKE_GOOGLE_TOKEN}"
    }
  },
  {
    "name": "appointments",
    "command": "${MIKE_HOME}\\.venv\\Scripts\\python.exe",
    "args": ["core/mcp/mike_appointments_mcp.py"],
    "tool_prefix": "appointments",
    "capabilities": ["appointments", "agenda", "family_operations"],
    "access": "owner"
  },
  {
    "name": "excel",
    "command": "${MIKE_HOME}\\.venv\\Scripts\\python.exe",
    "args": ["core/mcp/mike_excel_mcp.py", "${MIKE_HOME}"],
    "tool_prefix": "excel",
    "capabilities": ["spreadsheet", "excel"],
    "access": "owner"
  },
  {
    "name": "huggingface",
    "command": "${MIKE_HOME}\\.venv\\Scripts\\python.exe",
    "args": ["core/mcp/mike_huggingface_mcp.py"],
    "tool_prefix": "hf",
    "capabilities": ["huggingface", "models", "datasets", "model_cards"],
    "access": "any",
    "env": {
      "HF_TOKEN": "${HF_TOKEN}"
    }
  },
  {
    "name": "remote-agent",
    "command": "${MIKE_HOME}\\.venv\\Scripts\\python.exe",
    "args": ["core/mcp/mike_remote_agent_mcp.py"],
    "tool_prefix": "remote",
    "capabilities": ["remote_windows", "powershell", "operations"],
    "access": "owner",
    "env": {
      "MIKE_REMOTE_AGENT_URL": "${MIKE_REMOTE_AGENT_URL}",
      "MIKE_REMOTE_AGENT_KEY": "${MIKE_REMOTE_AGENT_KEY}",
      "MIKE_REMOTE_AGENT_EXEC_PATH": "${MIKE_REMOTE_AGENT_EXEC_PATH}"
    }
  },
  {
    "name": "filesystem",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-filesystem@2026.7.10", "${MIKE_HOME}"],
    "capabilities": ["file_read", "file_write", "directory_listing"],
    "access": "owner"
  },
  {
    "name": "github",
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-github@2025.4.8"],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
    },
    "capabilities": ["github_api", "repo_management", "pr_issues", "code_search"],
    "access": "owner"
  },
  {
    "name": "sqlite",
    "command": "npx",
    "args": ["-y", "mcp-server-sqlite@0.0.2", "--db", "${MIKE_HOME}\\runtime\\memory\\mike_local.db"],
    "capabilities": ["sqlite", "sql_query", "database", "local_db"],
    "access": "owner"
  },
  {
    "name": "fetch",
    "command": "npx",
    "args": ["-y", "mcp-fetch-server@1.1.2"],
    "enabled": false,
    "capabilities": ["http_fetch", "web_scrape", "api_call", "url_content"],
    "access": "owner"
  }
]
